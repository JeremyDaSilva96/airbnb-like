<div id="carousel-<%= property.id %>" class="carousel slide property-card__image-wrapper"
     data-bs-ride="false">
  <div class="carousel-inner">
    <% if property.photos.attached? %>
      <% property.photos.each_with_index do |photo, index| %>
        <div class="carousel-item property-card__image <%= 'active' if index == 0 %>">
          <%= cl_image_tag photo.key, alt: "Photo of #{property.title}" %>
        </div>
      <% end %>
    <% else %>
      <div class="carousel-item property-card__image active">
        <%= image_tag "https://images.unsplash.com/photo-1502672260266-1c1ef2d93688", alt: "Default property image" %>
      </div>
    <% end %>
  </div>
  <% if property.travelers_favorite? %>
    <div class="property-card__tag">
      <span>Coup de cœur voyageurs</span>
    </div>
  <% end %>
  <button class="property-card__favorite">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="rgba(0, 0, 0, 0.5)" stroke="white">
      <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z" />
    </svg>
  </button>
  <button class="carousel-control-prev property-card__nav property-card__nav--prev"
          type="button"
          data-bs-target="#carousel-<%= property.id %>"
          data-bs-slide="prev">
    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
    <span class="visually-hidden">Previous</span>
  </button>
  <button class="carousel-control-next property-card__nav property-card__nav--next"
          type="button"
          data-bs-target="#carousel-<%= property.id %>"
          data-bs-slide="next">
    <span class="carousel-control-next-icon" aria-hidden="true"></span>
    <span class="visually-hidden">Next</span>
  </button>
  <div class="carousel-indicators property-card__dots">
    <% if property.photos.attached? %>
      <% property.photos.each_with_index do |_, index| %>
        <button type="button"
                data-bs-target="#carousel-<%= property.id %>"
                data-bs-slide-to="<%= index %>"
                class="property-card__dot <%= 'active' if index == 0 %>"
                aria-current="<%= 'true' if index == 0 %>"
                aria-label="Slide <%= index + 1 %>"></button>
      <% end %>
    <% else %>
      <button type="button"
              data-bs-target="#carousel-<%= property.id %>"
              data-bs-slide-to="0"
              class="property-card__dot active"
              aria-current="true"
              aria-label="Slide 1"></button>
    <% end %>
  </div>
</div>
